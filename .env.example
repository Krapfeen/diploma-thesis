# Meta-level environment for the aggregate compose stack.
#
# Each submodule (server/, client/) ships its own `.env.example`
# for standalone use. When the full stack is run from this
# directory, docker compose resolves ${VARS} found in the
# included compose files against this file.
#
# Copy to .env and adjust before first run:
#   cp .env.example .env

# ─── PostgreSQL (server) ────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app

# ─── MinIO / S3-compatible storage (server) ─────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# ─── JWT signing key passphrase (server) ────────────────
# Consumed by `make keys` when generating the RSA keypair.
# Keep this value stable after the first generation —
# rotating it invalidates every token already issued.
JWT_PASSPHRASE=change_me
